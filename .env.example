# ── Database ────────────────────────────────────────────────────────────────
# For Docker: set POSTGRES_PASSWORD; compose builds DATABASE_URL from it when not set.
POSTGRES_PASSWORD=change_me
POSTGRES_DB=deepfake
# Full connection string. For Docker Compose use host "db"; for local dev use "localhost".
DATABASE_URL=postgresql://postgres:change_me@db:5432/deepfake

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_PATH=./data/storage
JOB_TTL_HOURS=24

# ── Limits ───────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=209715200
MAX_VIDEO_SECONDS=300

# ── CORS (API) ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production set this to your actual domain(s), e.g.:
# ALLOWED_ORIGINS=https://yourapp.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Rate limit (first free per IP per day) ────────────────────────────────────
# MAX_FIRST_FREE_PER_IP_PER_DAY=3

# ── Web ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
